# Copy to `.env.local` for local runs. Both are optional: an unset value
# emits no <meta> tag, so a fork or preview deploy never claims the domain.

# Google Search Console -> HTML tag verification. Get it from the URL-prefix
# property's "HTML tag" method; paste the token, not the whole tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools -> "Add site", "HTML meta tag" method.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
